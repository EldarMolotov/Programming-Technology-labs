<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Менеджер проектов и задач</title>
    <link rel="stylesheet" href="style.css">
    <script src="app.js" defer></script>
</head>
<body>
    <div class="container">
        <h1>Менеджер проектов и задач</h1>
        <p>Лабораторная работа №8 — JSON и LocalStorage</p>

        <section>
            <h2>Добавить проект</h2>
            <form id="projectForm">
                <input id="projectName" type="text"
                       placeholder="Название проекта" required>
                <input id="projectDate" type="date">
                <button type="submit">Добавить проект</button>
            </form>
        </section>

        <section>
            <h2>Поиск проектов и задач</h2>
            <input id="search" type="text"
                   placeholder="Введите название для поиска">
        </section>

        <section>
            <h2>Список проектов</h2>
            <div id="projects"></div>
            <p id="emptyMessage">Проектов пока нет.</p>
        </section>

        <section>
            <h2>Работа с данными</h2>
            <button id="exportBtn">Экспорт JSON</button>
            <button id="importBtn">Импорт JSON</button>
            <input id="importFile" type="file"
                   accept=".json" hidden>
            <button id="clearBtn" class="danger">Удалить все проекты</button>
            <p id="message"></p>
        </section>
    </div>
</body>
</html>




