script.js


const KEY = "lab8_projects";

const projectForm = document.getElementById("projectForm");
const projectName = document.getElementById("projectName");
const projectDate = document.getElementById("projectDate");
const projectsContainer = document.getElementById("projects");
const searchInput = document.getElementById("search");
const emptyMessage = document.getElementById("emptyMessage");
const message = document.getElementById("message");

let projects = loadProjects();

// Загружаем данные из LocalStorage
function loadProjects() {
    try {
        const data = localStorage.getItem(KEY);
        const result = data ? JSON.parse(data) : [];

        if (!Array.isArray(result)) {
            return [];
        }

        return result.filter(project =>
            project &&
            typeof project.id === "string" &&
            typeof project.name === "string" &&
            Array.isArray(project.tasks)
        );
    } catch (error) {
        return [];
    }
}

// Сохраняем данные в JSON
function saveProjects() {
    try {
        localStorage.setItem(KEY, JSON.stringify(projects));
        message.textContent = "Данные сохранены.";
    } catch (error) {
        message.textContent = "Ошибка сохранения данных.";
    }
}

function createId() {
    return Date.now().toString(36) +
        Math.random().toString(36).slice(2, 8);
}

// Добавление проекта
projectForm.addEventListener("submit", function(event) {
    event.preventDefault();

    const name = projectName.value.trim();

    if (!name) {
        message.textContent = "Введите название проекта.";
        return;
    }

    projects.push({
        id: createId(),
        name: name,
        date: projectDate.value,
        tasks: []
    });

    projectForm.reset();
    saveProjects();
    renderProjects();
});

// Отображение проектов и задач
function renderProjects() {
    projectsContainer.replaceChildren();

    const query = searchInput.value.trim().toLowerCase();

    const filtered = projects.filter(project =>
        project.name.toLowerCase().includes(query) ||
        project.tasks.some(task =>
            task.name.toLowerCase().includes(query)
        )
    );

    emptyMessage.hidden = filtered.length > 0;
    emptyMessage.textContent = projects.length
        ? "Ничего не найдено."
        : "Проектов пока нет.";

    filtered.forEach(project => {
        const card = document.createElement("div");
        card.className = "project";

        const title = document.createElement("h3");
        title.textContent = project.name;

        const date = document.createElement("p");
        date.textContent = project.date
            ? "Срок: " + project.date
            : "Срок не указан";

        const deleteProject = document.createElement("button");
        deleteProject.textContent = "Удалить проект";
        deleteProject.className = "danger";

        deleteProject.addEventListener("click", function() {
            projects = projects.filter(item =>
                item.id !== project.id
            );

            saveProjects();
            renderProjects();
        });

        const taskForm = document.createElement("form");
        const taskInput = document.createElement("input");
        taskInput.type = "text";
        taskInput.placeholder = "Название задачи";
        taskInput.required = true;

        const addTask = document.createElement("button");
        addTask.textContent = "Добавить задачу";

        taskForm.append(taskInput, addTask);

        taskForm.addEventListener("submit", function(event) {
            event.preventDefault();

            const name = taskInput.value.trim();

            if (!name) return;

            project.tasks.push({
                id: createId(),
                name: name,
                status: "Не начата"
            });

            saveProjects();
            renderProjects();
        });

        card.append(title, date, deleteProject, taskForm);

        project.tasks
            .filter(task =>
                !query ||
                project.name.toLowerCase().includes(query) ||
                task.name.toLowerCase().includes(query)
            )
            .forEach(task => {
                const row = document.createElement("div");
                row.className = "task";

                const taskName = document.createElement("span");
                taskName.textContent = task.name;

                if (task.status === "Выполнена") {
                    taskName.className = "completed";
                }

                const status = document.createElement("select");

                ["Не начата", "В процессе", "Выполнена"]
                    .forEach(value => {
                        const option = document.createElement("option");
                        option.value = value;
                        option.textContent = value;
                        option.selected = task.status === value;
                        status.append(option);
                    });

                status.addEventListener("change", function() {
                    task.status = status.value;
                    saveProjects();
                    renderProjects();
                });

                const deleteTask = document.createElement("button");
                deleteTask.textContent = "Удалить";
                deleteTask.className = "danger";

                deleteTask.addEventListener("click", function() {
                    project.tasks = project.tasks.filter(item =>
                        item.id !== task.id
                    );

                    saveProjects();
                    renderProjects();
                });

                row.append(taskName, status, deleteTask);
                card.append(row);
            });

        projectsContainer.append(card);
    });
}

// Поиск
searchInput.addEventListener("input", renderProjects);

// Экспорт данных в JSON-файл
document.getElementById("exportBtn").addEventListener("click", function() {
    const blob = new Blob(
        [JSON.stringify(projects, null, 2)],
        { type: "application/json" }
    );

    const url = URL.createObjectURL(blob);
    const link = document.createElement("a");

    link.href = url;
    link.download = "projects.json";
    link.click();

    URL.revokeObjectURL(url);
});

// Импорт JSON-файла
document.getElementById("importBtn").addEventListener("click", function() {
    document.getElementById("importFile").click();
});

document.getElementById("importFile").addEventListener("change", async function() {
    const file = this.files[0];
    if (!file) return;

    try {
        const imported = JSON.parse(await file.text());

        const valid = Array.isArray(imported) &&
            imported.every(project =>
                project &&
                typeof project.name === "string" &&
                Array.isArray(project.tasks) &&
                project.tasks.every(task =>
                    task &&
                    typeof task.name === "string" &&
                    ["Не начата", "В процессе", "Выполнена"]
                        .includes(task.status)
                )
            );

        if (!valid) {
            throw new Error("Неверный формат");
        }

        projects = imported.map(project => ({
            id: typeof project.id === "string"
                ? project.id : createId(),
            name: project.name,
            date: typeof project.date === "string"
                ? project.date : "",
            tasks: project.tasks.map(task => ({
                id: typeof task.id === "string"
                    ? task.id : createId(),
                name: task.name,
                status: task.status
            }))
        }));

        saveProjects();
        renderProjects();
        message.textContent = "Данные импортированы.";
    } catch (error) {
        message.textContent = "Ошибка: неверный JSON-файл.";
    }

    this.value = "";
});

// Удаление всех проектов
document.getElementById("clearBtn").addEventListener("click", function() {
    if (!confirm("Удалить все проекты?")) return;

    projects = [];
    localStorage.removeItem(KEY);

    renderProjects();
    message.textContent = "Все проекты удалены.";
});

// Первый показ данных
renderProjects();
