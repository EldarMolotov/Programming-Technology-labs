index.html

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>Учёт расходов</title>
    <link rel="stylesheet" href="style.css">
    <script src="script.js" defer></script>
</head>
<body>

    <h1>Учёт расходов</h1>

    <input id="category" placeholder="Категория">

    <input id="amount" type="number"
           min="0.01" step="0.01" placeholder="Сумма">

    <input id="date" type="date">

    <button id="add" type="button">Добавить расход</button>

    <p id="message"></p>

    <h2>Список расходов</h2>
    <ul id="list"></ul>

    <h2>Общий расход: <span id="total">0</span> тг</h2>

</body>
</html>



styles.css

