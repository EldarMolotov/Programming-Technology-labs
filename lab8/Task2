script.js


let expenses = [];

try {
    const saved = localStorage.getItem("expenses");

    if (saved !== null) {
        const data = JSON.parse(saved);

        if (Array.isArray(data)) {
            expenses = data.filter(function(item) {
                return item &&
                    typeof item.category === "string" &&
                    typeof item.amount === "number" &&
                    Number.isFinite(item.amount) &&
                    item.amount > 0 &&
                    typeof item.date === "string";
            });
        }
    }
} catch (error) {
    expenses = [];
}

const category = document.getElementById("category");
const amount = document.getElementById("amount");
const date = document.getElementById("date");
const add = document.getElementById("add");
const list = document.getElementById("list");
const total = document.getElementById("total");
const message = document.getElementById("message");

function show() {
    list.innerHTML = "";

    let sum = 0;

    expenses.forEach(function(expense, index) {
        const li = document.createElement("li");

        li.textContent =
            expense.category + " — " +
            expense.amount.toFixed(2) + " тг — " +
            expense.date + " ";

        sum += expense.amount;

        const del = document.createElement("button");
        del.textContent = "Удалить";
        del.type = "button";

        del.onclick = function() {
            expenses.splice(index, 1);
            save();
            message.textContent = "Расход удалён!";
        };

        li.appendChild(del);
        list.appendChild(li);
    });

    total.textContent = sum.toFixed(2);
}

function save() {
    try {
        localStorage.setItem(
            "expenses",
            JSON.stringify(expenses)
        );
        show();
    } catch (error) {
        alert("Не удалось сохранить расходы!");
    }
}

add.onclick = function() {
    const name = category.value.trim();
    const money = Number(amount.value);
    const day = date.value;

    if (name === "" || amount.value === "" ||
        !Number.isFinite(money) || money <= 0 ||
        day === "") {
        alert("Заполните все поля правильно!");
        return;
    }

    expenses.push({
        category: name,
        amount: money,
        date: day
    });

    category.value = "";
    amount.value = "";
    date.value = "";

    save();
    message.textContent = "Расход добавлен!";
};

show();

