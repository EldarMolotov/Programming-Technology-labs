<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Личный кабинет студента</title>
    <link rel="stylesheet" href="styles.css">
</head>
<body>

    <div class="container">

        <header>
            <h1>Личный кабинет студента</h1>
            <p>Система аутентификации и управления сессиями</p>
        </header>

        <main>

            <!-- Форма входа -->
            <section class="panel" id="loginPanel">
                <h2>Вход в систему</h2>

                <form id="loginForm">
                    <label for="username">Логин</label>
                    <input
                        type="text"
                        id="username"
                        placeholder="Введите логин"
                        autocomplete="username"
                    >

                    <label for="password">Пароль</label>
                    <input
                        type="password"
                        id="password"
                        placeholder="Введите пароль"
                        autocomplete="current-password"
                    >

                    <button type="submit">Войти</button>
                </form>

                <p id="message" aria-live="polite"></p>

                <div class="demo">
                    <h3>Тестовые аккаунты</h3>
                    <p>student1 / pass123</p>
                    <p>student2 / pass456</p>
                </div>
            </section>

            <!-- Личный кабинет -->
            <section class="panel hidden" id="accountPanel">
                <h2>Личный кабинет</h2>

                <p id="welcome"></p>
                <p id="role"></p>

                <div class="timer">
                    <p>Оставшееся время сессии:</p>
                    <h2 id="sessionTime">120 секунд</h2>
                </div>

                <button type="button" id="logoutButton" class="logout">
                    Выйти из системы
                </button>
            </section>

            <!-- Бронирования -->
            <section class="panel hidden" id="bookingPanel">
                <h2>Мои бронирования</h2>

                <div id="bookingList"></div>

                <h3>Проверка доступа к бронированию</h3>

                <label for="bookingId">ID бронирования</label>
                <input
                    type="number"
                    id="bookingId"
                    placeholder="Например, 101"
                >

                <button type="button" id="checkBookingButton">
                    Проверить доступ
                </button>

                <p id="bookingMessage" aria-live="polite"></p>
            </section>

            <!-- Информация -->
            <section class="panel">
                <h2>Информация о системе</h2>

                <p>Назначение: авторизация пользователей.</p>
                <p>Управление: пользовательские сессии.</p>
                <p>Дополнительно: проверка доступа к бронированиям.</p>
                <p>Технологии: HTML, CSS, JavaScript.</p>
            </section>

        </main>

        <footer>
            <p>Лабораторная работа №12</p>
            <p>Языки и технология программирования</p>
        </footer>

    </div>

    <script src="script.js"></script>
</body>
</html>



