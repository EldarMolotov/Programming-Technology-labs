script.js


// Тестовые пользователи
const users = [
    {
        username: "student1",
        password: "pass123",
        name: "Иван Иванов",
        role: "Студент"
    },
    {
        username: "student2",
        password: "pass456",
        name: "Петр Петров",
        role: "Студент"
    }
];

// Учебная база бронирований
const bookings = [
    {
        id: 101,
        username: "student1",
        resource: "Аудитория №101"
    },
    {
        id: 102,
        username: "student1",
        resource: "Компьютер №5"
    },
    {
        id: 201,
        username: "student2",
        resource: "Аудитория №202"
    }
];

// Получение элементов страницы
const loginPanel = document.getElementById("loginPanel");
const accountPanel = document.getElementById("accountPanel");
const bookingPanel = document.getElementById("bookingPanel");

const loginForm = document.getElementById("loginForm");
const usernameInput = document.getElementById("username");
const passwordInput = document.getElementById("password");

const message = document.getElementById("message");
const welcome = document.getElementById("welcome");
const role = document.getElementById("role");
const sessionTime = document.getElementById("sessionTime");

const logoutButton = document.getElementById("logoutButton");

const bookingList = document.getElementById("bookingList");
const bookingId = document.getElementById("bookingId");
const bookingMessage = document.getElementById("bookingMessage");
const checkBookingButton =
    document.getElementById("checkBookingButton");

// Состояние пользователя
let currentUser = null;

// Продолжительность сессии: 120 секунд
const SESSION_DURATION = 120000;

// Время окончания сессии
let sessionEnd = null;

// Таймер
let sessionTimer = null;

// Показ сообщения
function showMessage(text, type) {
    message.textContent = text;
    message.className = type;
}

// Проверка авторизации
function isAuthenticated() {
    return currentUser !== null &&
           sessionEnd !== null &&
           Date.now() < sessionEnd;
}

// Вход в систему
loginForm.addEventListener("submit", function(event) {
    event.preventDefault();

    const username = usernameInput.value.trim();
    const password = passwordInput.value;

    // Проверка пустых полей
    if (username === "" || password === "") {
        showMessage("Заполните все поля!", "error");
        return;
    }

    // Проверка учетных данных
    const user = users.find(function(item) {
        return item.username === username &&
               item.password === password;
    });

    if (!user) {
        showMessage("Неверный логин или пароль!", "error");
        return;
    }

    // Создание учебной сессии
    currentUser = user;
    sessionEnd = Date.now() + SESSION_DURATION;

    // Открытие личного кабинета
    loginPanel.classList.add("hidden");
    accountPanel.classList.remove("hidden");
    bookingPanel.classList.remove("hidden");

    welcome.textContent =
        "Добро пожаловать, " + user.name + "!";

    role.textContent =
        "Ваша роль: " + user.role;

    passwordInput.value = "";

    showMessage("Вход выполнен успешно!", "success");

    // Запуск таймера
    startSessionTimer();

    // Показ бронирований
    showBookings();
});

// Запуск таймера сессии
function startSessionTimer() {
    clearInterval(sessionTimer);

    updateSessionTime();

    sessionTimer = setInterval(function() {
        updateSessionTime();
    }, 1000);
}

// Обновление оставшегося времени
function updateSessionTime() {
    if (!currentUser || sessionEnd === null) {
        return;
    }

    const remaining = Math.max(
        0,
        Math.ceil((sessionEnd - Date.now()) / 1000)
    );

    sessionTime.textContent = remaining + " секунд";

    if (remaining <= 0) {
        logout("Время сессии истекло. Войдите снова.");
    }
}

// Выход из системы
function logout(reason) {
    clearInterval(sessionTimer);

    currentUser = null;
    sessionEnd = null;

    loginPanel.classList.remove("hidden");
    accountPanel.classList.add("hidden");
    bookingPanel.classList.add("hidden");

    welcome.textContent = "";
    role.textContent = "";
    sessionTime.textContent = "";

    bookingList.innerHTML = "";
    bookingId.value = "";
    bookingMessage.textContent = "";

    usernameInput.value = "";
    passwordInput.value = "";

    if (reason) {
        showMessage(reason, "error");
    } else {
        showMessage("Вы вышли из системы.", "success");
    }
}

// Кнопка выхода
logoutButton.addEventListener("click", function() {
    logout();
});

// Отображение бронирований пользователя
function showBookings() {
    bookingList.innerHTML = "";

    if (!isAuthenticated()) {
        bookingMessage.textContent =
            "Ошибка 401: необходимо войти в систему.";
        return;
    }

    const userBookings = bookings.filter(function(booking) {
        return booking.username === currentUser.username;
    });

    if (userBookings.length === 0) {
        bookingList.textContent = "Бронирований нет.";
        return;
    }

    userBookings.forEach(function(booking) {
        const item = document.createElement("div");

        item.className = "booking";

        item.textContent =
            "ID: " + booking.id +
            " | " + booking.resource;

        bookingList.appendChild(item);
    });
}

// Проверка доступа к бронированию
checkBookingButton.addEventListener("click", function() {

    // Проверка авторизации
    if (!isAuthenticated()) {
        bookingMessage.textContent =
            "Ошибка 401: необходимо войти в систему.";
        return;
    }

    const id = Number(bookingId.value);

    // Проверка введенного ID
    if (
        bookingId.value.trim() === "" ||
        !Number.isInteger(id) ||
        id <= 0
    ) {
        bookingMessage.textContent =
            "Введите корректный ID бронирования.";
        return;
    }

    // Поиск бронирования
    const booking = bookings.find(function(item) {
        return item.id === id;
    });

    if (!booking) {
        bookingMessage.textContent =
            "Бронирование не найдено.";
        return;
    }

    // Проверка владельца ресурса
    if (booking.username !== currentUser.username) {
        bookingMessage.textContent =
            "Ошибка 403: доступ к чужому бронированию запрещен.";
        return;
    }

    // Разрешение доступа
    bookingMessage.textContent =
        "Доступ разрешен! Ваш ресурс: " + booking.resource;
});
