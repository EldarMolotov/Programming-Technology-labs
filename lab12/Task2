script.js




// Данные пользователя
const user = {
    username: "student1",
    password: "pass123",
    name: "Иван Иванов"
};

// Продолжительность сессии
const SESSION_DURATION = 120;

// Получение элементов
const loginForm = document.getElementById("loginForm");
const loginPanel = document.getElementById("loginPanel");
const accountPanel = document.getElementById("accountPanel");

const usernameInput = document.getElementById("username");
const passwordInput = document.getElementById("password");

const message = document.getElementById("message");
const welcome = document.getElementById("welcome");
const timer = document.getElementById("timer");

const logoutButton = document.getElementById("logoutButton");

// Состояние сессии
let isLoggedIn = false;
let sessionEnd = null;
let timerInterval = null;

// Вход
loginForm.addEventListener("submit", function(event) {
    event.preventDefault();

    const username = usernameInput.value.trim();
    const password = passwordInput.value;

    if (username === "" || password === "") {
        message.textContent = "Заполните все поля!";
        message.className = "error";
        return;
    }

    if (
        username === user.username &&
        password === user.password
    ) {
        isLoggedIn = true;

        sessionEnd = Date.now() + SESSION_DURATION * 1000;

        loginPanel.classList.add("hidden");
        accountPanel.classList.remove("hidden");

        welcome.textContent =
            "Здравствуйте, " + user.name + "!";

        passwordInput.value = "";

        startTimer();
    } else {
        message.textContent = "Неверный логин или пароль!";
        message.className = "error";
    }
});

// Запуск таймера
function startTimer() {
    clearInterval(timerInterval);

    updateTimer();

    timerInterval = setInterval(function() {
        updateTimer();
    }, 1000);
}

// Обновление таймера
function updateTimer() {
    if (!isLoggedIn) {
        return;
    }

    const remaining = Math.max(
        0,
        Math.ceil((sessionEnd - Date.now()) / 1000)
    );

    timer.textContent = remaining + " секунд";

    if (remaining <= 0) {
        logout("Время сессии истекло. Войдите снова.");
    }
}

// Выход
function logout(reason) {
    clearInterval(timerInterval);

    isLoggedIn = false;
    sessionEnd = null;

    accountPanel.classList.add("hidden");
    loginPanel.classList.remove("hidden");

    usernameInput.value = "";
    passwordInput.value = "";

    timer.textContent = "120 секунд";

    message.textContent =
        reason || "Вы успешно вышли из системы.";

    message.className = reason ? "error" : "success";
}

// Кнопка выхода
logoutButton.addEventListener("click", function() {
    logout();
});
