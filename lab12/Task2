<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Управление сессией</title>
    <link rel="stylesheet" href="styles.css">
</head>
<body>

    <div class="container">
        <header>
            <h1>Личный кабинет</h1>
            <p>Управление пользовательской сессией</p>
        </header>

        <section class="panel" id="loginPanel">
            <h2>Авторизация</h2>

            <form id="loginForm">
                <label for="username">Логин</label>
                <input type="text" id="username"
                       placeholder="Введите логин">

                <label for="password">Пароль</label>
                <input type="password" id="password"
                       placeholder="Введите пароль">

                <button type="submit">Войти</button>
            </form>

            <p id="message"></p>

            <div class="demo">
                <p>Логин: student1</p>
                <p>Пароль: pass123</p>
            </div>
        </section>

        <section class="panel hidden" id="accountPanel">
            <h2>Добро пожаловать!</h2>

            <p id="welcome"></p>

            <div class="timer">
                <p>Осталось времени сессии:</p>
                <h1 id="timer">120 секунд</h1>
            </div>

            <button id="logoutButton" class="logout">
                Выйти
            </button>
        </section>

        <footer>
            <p>Лабораторная работа №12</p>
        </footer>
    </div>

    <script src="script.js"></script>
</body>
</html>




