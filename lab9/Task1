<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Список пользователей</title>
    <link rel="stylesheet" href="styles.css">
    <script src="script.js" defer></script>
</head>
<body>
    <h1>Список пользователей</h1>

    <button id="load" type="button">Загрузить пользователей</button>

    <input id="search" type="text" placeholder="Поиск по имени">

    <p id="status" role="status">Нажмите кнопку для загрузки.</p>
    <button id="retry" type="button" hidden>Повторить</button>

    <ul id="users"></ul>
</body>
</html>


styles.css



body {
