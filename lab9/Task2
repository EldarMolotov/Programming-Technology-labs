<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Пользователи и публикации</title>
    <link rel="stylesheet" href="styles.css">
    <script src="script.js" defer></script>
</head>
<body>
    <h1>Пользователи и публикации</h1>

    <button id="load" type="button">Загрузить пользователей</button>
    <input id="search" placeholder="Поиск по имени">

    <p id="status" role="status">Нажмите кнопку для загрузки.</p>
    <button id="retry" type="button" hidden>Повторить</button>

    <div id="users"></div>
</body>
</html>


styles.css



body {
    font-family: Arial, sans-serif;
    max-width: 900px;
    margin: 30px auto;
    padding: 20px;
    background: #f0f4f8;
}

h1 {
    color: #24527a;
}

