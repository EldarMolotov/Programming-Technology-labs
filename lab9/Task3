<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Пользователи, публикации и комментарии</title>
    <link rel="stylesheet" href="styles.css">
    <script src="script.js" defer></script>
</head>
<body>
    <h1>Пользователи, публикации и комментарии</h1>

    <button id="loadUsers" type="button">Загрузить пользователей</button>

    <label for="user">Выберите пользователя:</label>
    <select id="user" disabled>
        <option value="">Сначала загрузите пользователей</option>
    </select>

    <p id="status" role="status">Ожидание загрузки.</p>
    <p id="counter">Успешных загрузок ресурсов: 0</p>

    <button id="retry" type="button" hidden>Повторить</button>

    <h2>Публикации</h2>
    <div id="posts"></div>
</body>
</html>


styles.css



body {
    font-family: Arial, sans-serif;
    max-width: 900px;
    margin: 30px auto;
    padding: 20px;
    background: #f4f0fa;
}

