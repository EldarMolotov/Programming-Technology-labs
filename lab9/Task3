script.js



const loadButton = document.getElementById("loadUsers");
const userSelect = document.getElementById("user");
const status = document.getElementById("status");
const counter = document.getElementById("counter");
const retryButton = document.getElementById("retry");
const postsBox = document.getElementById("posts");

let successfulLoads = 0;
let lastAction = loadUsers;

function setStatus(text, type) {
    status.textContent = text;
    status.className = type;
}

function updateCounter() {
    counter.textContent =
        "Успешных загрузок ресурсов: " + successfulLoads;
}

async function getData(url) {
    const response = await fetch(url);

    if (!response.ok) {
        throw new Error("HTTP " + response.status);
    }

    return await response.json();
}

// Загружаем пользователей
async function loadUsers() {
    loadButton.disabled = true;
    retryButton.hidden = true;
    setStatus("Загрузка пользователей...", "");

    try {
        const users = await getData(
            "https://jsonplaceholder.typicode.com/users"
        );

        if (!Array.isArray(users)) {
            throw new Error("Неверный формат данных");
        }

        userSelect.replaceChildren();

        const firstOption = document.createElement("option");
        firstOption.value = "";
        firstOption.textContent = "Выберите пользователя";
        userSelect.appendChild(firstOption);

        users.forEach(function(user) {
            const option = document.createElement("option");
            option.value = user.id;
            option.textContent = user.name;
            userSelect.appendChild(option);
        });

        userSelect.disabled = false;
        successfulLoads++;
        updateCounter();

        setStatus("Успех! Пользователи загружены.", "success");
    } catch (error) {
        setStatus("Ошибка: " + error.message, "error");
        retryButton.hidden = false;
    } finally {
        loadButton.disabled = false;
    }
}

// Загружаем публикации выбранного пользователя
async function loadPosts() {
    const userId = userSelect.value;
    postsBox.replaceChildren();

    if (userId === "") {
        return;
    }

    retryButton.hidden = true;
    setStatus("Загрузка публикаций...", "");

    lastAction = loadPosts;

    try {
        const posts = await getData(
            "https://jsonplaceholder.typicode.com/posts?userId=" + userId
        );

        posts.forEach(function(post) {
            const card = document.createElement("div");
            card.className = "post";

            const title = document.createElement("h3");
            title.textContent = post.title;

            const text = document.createElement("p");
            text.textContent = post.body;

            const button = document.createElement("button");
            button.textContent = "Показать комментарии";

            const commentsBox = document.createElement("div");

            button.onclick = async function() {
                button.disabled = true;
                commentsBox.replaceChildren();
                retryButton.hidden = true;
                setStatus("Загрузка комментариев...", "");

                lastAction = async function() {
                    await loadComments(post.id, commentsBox, button);
                };

                await lastAction();
            };

            card.appendChild(title);
            card.appendChild(text);
            card.appendChild(button);
            card.appendChild(commentsBox);
            postsBox.appendChild(card);
        });

        successfulLoads++;
        updateCounter();
        setStatus("Успех! Публикаций: " + posts.length, "success");
    } catch (error) {
        setStatus("Ошибка: " + error.message, "error");
        retryButton.hidden = false;
    }
}

// Загружаем комментарии к публикации
async function loadComments(postId, box, button) {
    button.disabled = true;
    retryButton.hidden = true;

    try {
        const comments = await getData(
            "https://jsonplaceholder.typicode.com/comments?postId=" + postId
        );

        box.replaceChildren();

        comments.forEach(function(comment) {
            const item = document.createElement("div");
            item.className = "comment";

            const name = document.createElement("strong");
            name.textContent = comment.name;

            const email = document.createElement("p");
            email.textContent = "Email: " + comment.email;

            const text = document.createElement("p");
            text.textContent = comment.body;

            item.appendChild(name);
            item.appendChild(email);
            item.appendChild(text);
            box.appendChild(item);
        });

        successfulLoads++;
        updateCounter();
        button.textContent = "Комментарии загружены";

        setStatus("Успех! Комментариев: " + comments.length, "success");
    } catch (error) {
        setStatus("Ошибка: " + error.message, "error");
        retryButton.hidden = false;
    } finally {
        button.disabled = false;
    }
}

loadButton.addEventListener("click", function() {
    lastAction = loadUsers;
    loadUsers();
});

userSelect.addEventListener("change", loadPosts);

retryButton.addEventListener("click", function() {
    lastAction();
});

updateCounter();
