script.js



const products = [
    { id: 1, name: "Ноутбук", price: 250000 },
    { id: 2, name: "Мышка", price: 5000 },
    { id: 3, name: "Клавиатура", price: 12000 },
    { id: 4, name: "Наушники", price: 15000 }
];

// Состояние корзины
let cart = [];

// Дочерний компонент товара (props)
function ProductCard(props) {
    return `
        <div class="product">
            <div>
                <h3>${props.name}</h3>
                <p>Цена: ${props.price} тенге</p>
            </div>

            <button onclick="addToCart(${props.id})">
                Добавить
            </button>
        </div>
    `;
}

// Отображение каталога
function showProducts() {
    document.getElementById("products").innerHTML =
        products.map(function(product) {
            return ProductCard(product);
        }).join("");
}

// Добавление товара
function addToCart(id) {
    const product = products.find(function(item) {
        return item.id === id;
    });

    if (product) {
        cart.push(product);
        showCart();
    }
}

// Удаление товара
function removeFromCart(index) {
    cart.splice(index, 1);
    showCart();
}

// Отображение корзины
function showCart() {
    const cartItems = document.getElementById("cartItems");

    if (cart.length === 0) {
        cartItems.textContent = "Корзина пуста";
    } else {
        cartItems.innerHTML = cart.map(function(item, index) {
            return `
                <div class="cartItem">
                    <span>${item.name} — ${item.price} тенге</span>
                    <button class="remove"
                        onclick="removeFromCart(${index})">
                        Удалить
                    </button>
                </div>
            `;
        }).join("");
    }

    const total = cart.reduce(function(sum, item) {
        return sum + item.price;
    }, 0);

    document.getElementById("total").textContent =
        "Количество товаров: " + cart.length +
        " | Общая сумма: " + total + " тенге";
}

// Очистка корзины
document.getElementById("clearButton").addEventListener("click", function() {
    cart = [];
    showCart();
});

// Запуск
showProducts();
showCart();
