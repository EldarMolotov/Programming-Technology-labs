script.js



let students = [
    {
        id: 1,
        name: "Иван Иванов",
        group: "ИТ-22",
        grades: [5, 4, 5]
    },
    {
        id: 2,
        name: "Петр Петров",
        group: "ИТ-22",
        grades: [3, 4, 4]
    },
    {
        id: 3,
        name: "Анна Смирнова",
        group: "ИТ-23",
        grades: [5, 5, 4]
    }
];

// Дочерний компонент (props)
function StudentRow(props) {
    const average = props.grades.length > 0
        ? (
            props.grades.reduce(function(sum, grade) {
                return sum + grade;
            }, 0) / props.grades.length
        ).toFixed(2)
        : "Нет оценок";

    return `
        <div class="student">
            <h3>${props.name}</h3>
            <p>Группа: ${props.group}</p>
            <p>Оценки: ${props.grades.join(", ")}</p>
            <p class="average">Средний балл: ${average}</p>

            <input
                type="number"
                id="grade-${props.id}"
                min="1"
                max="5"
                step="1"
                placeholder="Введите оценку"
            >

            <button onclick="addGrade(${props.id})">
                Добавить оценку
            </button>
        </div>
    `;
}

// Отображение студентов
function showStudents() {
    const search = document.getElementById("search")
        .value.toLowerCase();

    const filtered = students.filter(function(student) {
        return student.name.toLowerCase().includes(search);
    });

    const container = document.getElementById("students");

    if (filtered.length === 0) {
        container.innerHTML = "<p>Студенты не найдены.</p>";
    } else {
        container.innerHTML = filtered.map(function(student) {
            return StudentRow(student);
        }).join("");
    }

    updateStatistics();
}

// Добавление оценки
function addGrade(id) {
    const input = document.getElementById("grade-" + id);

    if (!input || input.value.trim() === "") {
        alert("Введите оценку!");
        return;
    }

    const grade = Number(input.value);

    if (!Number.isInteger(grade) || grade < 1 || grade > 5) {
        alert("Оценка должна быть целым числом от 1 до 5!");
        return;
    }

    const student = students.find(function(item) {
        return item.id === id;
    });

    if (student) {
        student.grades.push(grade);
        showStudents();
    }
}

// Общая статистика
function updateStatistics() {
    const allGrades = students.reduce(function(result, student) {
        return result.concat(student.grades);
    }, []);

    const average = allGrades.length > 0
        ? (
            allGrades.reduce(function(sum, grade) {
                return sum + grade;
            }, 0) / allGrades.length
        ).toFixed(2)
        : "Нет оценок";

    document.getElementById("studentCount").textContent =
        "Количество студентов: " + students.length;

    document.getElementById("gradeCount").textContent =
        "Количество оценок: " + allGrades.length;

    document.getElementById("average").textContent =
        "Средний балл группы: " + average;
}

// Поиск
document.getElementById("search").addEventListener("input", function() {
    showStudents();
});

// Запуск приложения
showStudents();
