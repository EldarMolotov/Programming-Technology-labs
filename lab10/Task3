script.js


const form = document.getElementById("bookingForm");
const room = document.getElementById("room");
const date = document.getElementById("date");
const start = document.getElementById("start");
const end = document.getElementById("end");
const message = document.getElementById("message");
const bookingList = document.getElementById("bookingList");

let bookings = [];

function checkData() {
    if (!room.value || !date.value || !start.value || !end.value) {
        return "Заполните все поля!";
    }

    if (start.value >= end.value) {
        return "Время окончания должно быть позже начала!";
    }

    return "";
}

function addBooking(newBooking) {
    for (let booking of bookings) {
        if (
            booking.room === newBooking.room &&
            booking.date === newBooking.date &&
            newBooking.start < booking.end &&
            newBooking.end > booking.start
        ) {
            return false;
        }
    }

    bookings.push(newBooking);
    return true;
}

function showBookings() {
    bookingList.innerHTML = "";

    if (bookings.length === 0) {
        bookingList.innerHTML =
            '<p class="empty">Пока нет бронирований</p>';
        return;
    }

    bookings.forEach((booking, index) => {
        const item = document.createElement("div");
        item.className = "booking";

        item.innerHTML = `
            <p><strong>Аудитория:</strong> ${booking.room}</p>
            <p><strong>Дата:</strong> ${booking.date}</p>
            <p><strong>Время:</strong> ${booking.start} - ${booking.end}</p>
            <button class="delete" data-index="${index}">
                Удалить
            </button>
        `;

        bookingList.appendChild(item);
    });
}

form.addEventListener("submit", function(event) {
    event.preventDefault();

    const error = checkData();

    if (error) {
        message.style.color = "red";
        message.textContent = error;
        return;
    }

    const newBooking = {
        room: room.value,
        date: date.value,
        start: start.value,
        end: end.value
    };

    if (!addBooking(newBooking)) {
        message.style.color = "red";
        message.textContent =
            "Эта аудитория уже забронирована на указанное время!";
        return;
    }

    message.style.color = "green";
    message.textContent = "Бронирование успешно добавлено!";

    form.reset();
    showBookings();
});

bookingList.addEventListener("click", function(event) {
    if (event.target.classList.contains("delete")) {
        const index = Number(event.target.dataset.index);

        bookings.splice(index, 1);

        showBookings();

        message.style.color = "green";
        message.textContent = "Бронирование удалено!";
    }
});

showBookings();



