<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Бронирование аудиторий</title>

    <link rel="stylesheet" href="styles.css">
    <script type="module" src="main.js"></script>
</head>
<body>

    <main class="container">
        <h1>Бронирование аудиторий</h1>

        <section class="card">
            <h2>Новое бронирование</h2>

            <form id="bookingForm">
                <label for="room">Аудитория</label>
                <select id="room" required>
                    <option value="">Выберите аудиторию</option>
                    <option value="101">Аудитория 101</option>
                    <option value="102">Аудитория 102</option>
                    <option value="103">Аудитория 103</option>
                    <option value="201">Аудитория 201</option>
                    <option value="202">Аудитория 202</option>
                </select>

                <label for="date">Дата</label>
                <input type="date" id="date" required>

                <label for="start">Время начала</label>
                <input type="time" id="start" required>

                <label for="end">Время окончания</label>
                <input type="time" id="end" required>

                <button type="submit">Забронировать</button>
            </form>

            <p id="message"></p>
        </section>

        <section class="card">
            <h2>Список бронирований</h2>
            <div id="bookingList">
                <p class="empty">Пока нет бронирований</p>
            </div>
        </section>
    </main>

</body>
</html>



