script.js



import {
    addTransaction,
    getTransactions,
    calculateTotals,
    clearTransactions
} from "./budget.js";

import {
    renderBudget,
    renderTransactions,
    showMessage,
    clearMessage
} from "./ui.js";

const descriptionInput = document.querySelector("#description");
const amountInput = document.querySelector("#amount");
const typeInput = document.querySelector("#type");

function updateInterface() {
    renderBudget(calculateTotals());
    renderTransactions(getTransactions());
}

document.querySelector("#add").addEventListener("click", () => {
    const description = descriptionInput.value.trim();
    const amount = Number(amountInput.value);
    const type = typeInput.value;

    if (!description || amountInput.value.trim() === "" ||
        !Number.isFinite(amount) || amount <= 0) {

        showMessage("Введите название и корректную сумму!");
        return;
    }

    if (type !== "income" && type !== "expense") {
        showMessage("Выберите правильный тип операции!");
        return;
    }

    addTransaction(description, amount, type);

    descriptionInput.value = "";
    amountInput.value = "";

    clearMessage();
    updateInterface();
});

document.querySelector("#clear").addEventListener("click", () => {
    clearTransactions();
    updateInterface();
    clearMessage();
});

updateInterface();




budget.js



let transactions = [];

export function addTransaction(description, amount, type) {
    const transaction = {
        id: Date.now() + Math.random(),
        description,
        amount,
        type
    };

    transactions.push(transaction);

    return transaction;
}

export function getTransactions() {
    return [...transactions];
}

export function calculateTotals() {
    const income = transactions
        .filter(item => item.type === "income")
        .reduce((sum, item) => sum + item.amount, 0);

    const expense = transactions
        .filter(item => item.type === "expense")
        .reduce((sum, item) => sum + item.amount, 0);

    return {
        income,
        expense,
        balance: income - expense
    };
}

export function clearTransactions() {
    transactions = [];
}





format.js




export function formatMoney(amount) {
    return amount.toLocaleString("ru-RU", {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
    }) + " ₸";
}

export function formatTransaction(transaction) {
    const sign = transaction.type === "income" ? "+" : "-";

    return `${sign}${formatMoney(transaction.amount)}`;
}



ui.js



import { formatMoney, formatTransaction } from "./format.js";

export function renderBudget(totals) {
    document.querySelector("#income").textContent =
        formatMoney(totals.income);

    document.querySelector("#expense").textContent =
        formatMoney(totals.expense);

    document.querySelector("#balance").textContent =
        formatMoney(totals.balance);
}

export function renderTransactions(transactions) {
    const list = document.querySelector("#transactions");

    list.innerHTML = "";

    transactions.forEach(transaction => {
        const item = document.createElement("li");

        item.textContent =
            transaction.description + " — " +
            formatTransaction(transaction);

        list.appendChild(item);
    });
}

export function showMessage(message) {
    document.querySelector("#message").textContent = message;
}

export function clearMessage() {
    document.querySelector("#message").textContent = "";
}
