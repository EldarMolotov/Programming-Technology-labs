script.js



import {
    calculateDiscount,
    calculateFinalPrice
} from "./script1.js";

const priceInput = document.querySelector("#price");
const discountInput = document.querySelector("#discount");
const result = document.querySelector("#result");

document.querySelector("#calculate").addEventListener("click", () => {
    const price = Number(priceInput.value);
    const discount = Number(discountInput.value);

    if (
        priceInput.value.trim() === "" ||
        discountInput.value.trim() === "" ||
        !Number.isFinite(price) ||
        !Number.isFinite(discount) ||
        price <= 0 ||
        discount < 0 ||
        discount > 100
    ) {
        result.textContent = "Введите корректную цену и скидку от 0 до 100%!";
        return;
    }

    const saved = calculateDiscount(price, discount);
    const total = calculateFinalPrice(price, discount);

    result.innerHTML = `
        Цена товара: ${price.toFixed(2)} ₸<br>
        Сумма скидки: ${saved.toFixed(2)} ₸<br>
        Итоговая стоимость: ${total.toFixed(2)} ₸
    `;
});

document.querySelector("#clear").addEventListener("click", () => {
    priceInput.value = "";
    discountInput.value = "";
    result.textContent = "";
});




script1.js


export function calculateDiscount(price, discount) {
    return price * discount / 100;
}

export function calculateFinalPrice(price, discount) {
    return price - calculateDiscount(price, discount);
}
