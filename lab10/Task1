    <div class="container">
        <h1>Калькулятор скидки</h1>
        <p>Рассчитайте стоимость товара с учётом скидки.</p>

        <label>Цена товара (₸):</label>
        <input type="number" id="price" placeholder="Введите цену">

        <label>Скидка (%):</label>
        <input type="number" id="discount" placeholder="Введите скидку">

        <button id="calculate">Рассчитать</button>
        <button id="clear" class="clear">Очистить</button>

        <div id="result"></div>
    </div>

    <script type="module" src="script.js"></script>
</body>
</html>




