index.html


<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Электронный журнал</title>
    <link rel="stylesheet" href="style.css">
    <script src="script.js" defer></script>
</head>
<body>
    <h1>Электронный журнал</h1>

    <nav>
        <button data-page="students">Студенты</button>
        <button data-page="grades">Оценки</button>
        <button data-page="stats">Статистика</button>
    </nav>

    <form id="studentForm">
        <input id="studentName" type="text" placeholder="Имя студента">
        <input id="studentGrade" type="number" min="2" max="5"
               placeholder="Оценка">
        <button type="submit">Добавить</button>
    </form>

    <p id="message"></p>
    <main id="content"></main>
</body>
</html>




styles.css


body {
    font-family: Arial, sans-serif;
    background: #f3eff8;
    margin: 0;
    padding: 20px;
}

h1 {
    text-align: center;
    color: #7041a3;
}

nav, form {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: center;
    margin-bottom: 20px;
}

button, input {
    padding: 10px;
    border: 1px solid #ccc;
    border-radius: 5px;
}

button {
    background: #e6daf5;
    cursor: pointer;
}

button.active {
    background: #7041a3;
    color: white;
}

.card {
    background: white;
    padding: 15px;
    margin: 10px auto;
    max-width: 600px;
    border-radius: 5px;
}

#message {
    text-align: center;
    color: red;
}

@media (max-width: 500px) {
    body {
        padding: 10px;
    }

    form input {
        width: 100%;
    }
}




script.js


let students = [
    { name: "Алия", grade: 5 },
    { name: "Данияр", grade: 4 },
    { name: "Марат", grade: 3 }
];

let currentPage = "students";

const content = document.querySelector("#content");
const buttons = document.querySelectorAll("[data-page]");
const form = document.querySelector("#studentForm");
const nameInput = document.querySelector("#studentName");
const gradeInput = document.querySelector("#studentGrade");
const message = document.querySelector("#message");

function showPage() {
    content.replaceChildren();
    message.textContent = "";

    if (currentPage === "students") {
        students.forEach(student => {
            const card = document.createElement("div");
            card.className = "card";
            card.textContent = student.name;
            content.append(card);
        });
    }

    if (currentPage === "grades") {
        students.forEach(student => {
            const card = document.createElement("div");
            card.className = "card";
            card.textContent =
                student.name + " — оценка: " + student.grade;
            content.append(card);
        });
    }

    if (currentPage === "stats") {
        if (students.length === 0) {
            content.textContent = "Пока нет студентов.";
        } else {
            let sum = 0;

            students.forEach(student => {
                sum += student.grade;
            });

            const average = sum / students.length;
            const card = document.createElement("div");

            card.className = "card";
            card.textContent =
                "Количество студентов: " + students.length +
                ". Средний балл: " + average.toFixed(2);

            content.append(card);
        }
    }

    buttons.forEach(button => {
        button.classList.toggle(
            "active",
            button.dataset.page === currentPage
        );
    });
}

buttons.forEach(button => {
    button.addEventListener("click", function() {
        currentPage = button.dataset.page;
        showPage();
    });
});

form.addEventListener("submit", function(event) {
    event.preventDefault();

    const name = nameInput.value.trim();
    const grade = Number(gradeInput.value);

    if (name === "") {
        message.textContent = "Введите имя студента!";
        return;
    }

    if (gradeInput.value === "" ||
        !Number.isInteger(grade) ||
        grade < 2 || grade > 5) {
        message.textContent = "Введите оценку от 2 до 5!";
        return;
    }

    students.push({ name: name, grade: grade });

    nameInput.value = "";
    gradeInput.value = "";

    currentPage = "students";
    showPage();
});

showPage();
